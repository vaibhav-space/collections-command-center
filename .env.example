# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/financeops_db?schema=public"

# Google Gemini API Configuration (Official Vercel AI SDK Core @ai-sdk/google)
# Note: Optional for local evaluation! If left blank, the app gracefully falls back to deterministic heuristic intelligence.
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
DEFAULT_TENANT_CODE="FINOPS_DEMO"
